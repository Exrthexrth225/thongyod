# Copy to .env and enter your app-role password there. Never commit .env.
NODE_ENV=development
APP_ENV=local
# Off by default. Dev login requires all three local development flags.
ENABLE_DEV_LOGIN=false
# Production logout origin (exact HTTPS origin, no trailing slash):
# APP_ORIGIN=https://your-app.example
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=thongyod_dev
PGUSER=thongyod_app
# Required: enter the app-role password in .env. Quote values containing # or spaces.
PGPASSWORD=
TEST_PGDATABASE=thongyod_test
# Required for recoverable friend links: 32 random bytes encoded as standard base64.
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
# Local disk is allowed only with local development flags. Production requires supabase.
MEDIA_STORAGE=local
# MEDIA_LOCAL_DIR=C:/path/to/local/media
# MEDIA_STORAGE=supabase
# MEDIA_SUPABASE_URL=https://your-project.supabase.co
# MEDIA_BUCKET=profile-images
# MEDIA_SERVICE_KEY=server-only-secret
# Real login (register the callback URL in LINE Developers):
# LINE_CHANNEL_ID=
# LINE_CHANNEL_SECRET=
# LINE_CALLBACK_URL=https://your-app.example/api/auth/line/callback
# Production hosting:
# NODE_ENV=production
# APP_ENV=production
# SERVE_WEB=true
# WEB_DIST_DIR=/absolute/path/to/apps/web/dist
# DATABASE_URL=postgresql://app_role:password@your-neon-host/dbname?sslmode=verify-full
# Direct/session connection for migrations; do not use transaction pooling for advisory locks.
# MIGRATION_DATABASE_URL=postgresql://migration_role:password@your-direct-host/dbname?sslmode=verify-full
# PGPOOL_MAX=3
# PGSSLMODE=verify-full
# Optional fixed ISO instant for reproducible dates; otherwise uses the current day.
# SEED_ANCHOR=2026-11-03T05:00:00.000Z
